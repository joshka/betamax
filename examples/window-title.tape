Output examples/output/window-title.png

Set Shell "bash"
Set Width 720
Set Height 360
Set FontSize 20
Set FontFamily "Menlo"
Set Padding 20
Set Margin 24
Set MarginFill "#232640"
Set WindowBar Colorful
Set WindowTitle "jk — log"
Set WindowTitleColor "auto"
Set BorderRadius 11
Set CursorBlink false

Hide
Type "clear; printf 'Window titles frame your terminal recordings.\n'"
Enter
Wait+Screen "Window titles frame"
Show
Sleep 100ms
