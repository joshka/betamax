# Decorative borders and rounded corners surround complete terminal cells.
Output examples/output/window-cell-boundaries.png
Require python3
Set Shell "python3 scripts/feature-scene.py cell-edges"
Set Width 400
Set Height 240
Set FontSize 24
Set LetterSpacing 0
Set LineHeight 1
Set Padding 0
Set Margin 20
Set MarginFill "#344354"
Set WindowBar Colorful
Set WindowBarColor "#111824"
Set WindowTitle "Cells reach every edge"
Set WindowTitleFromTerminal false
Set BorderRadius 18
Set WindowBorder 3
Set WindowBorderOpacity 1
Set Shadow false
Set Theme "Aardvark Ink"
Set CursorBlink false
Sleep 200ms
